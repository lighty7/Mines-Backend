generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  address      String?
  role         Role           @default(USER)
  isBanned     Boolean        @default(false)
  bannedReason String?
  balance      Decimal        @default(1000) @db.Decimal(18, 8)
  createdAt    DateTime       @default(now())
  games           GameRound[]
  transactions    Transaction[]
  slotRounds      SlotRound[]
  rouletteRounds  RouletteRound[]
  blackjackRounds BlackjackRound[]
  coinFlipRounds  CoinFlipRound[]
}

model GameRound {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet            Decimal     @db.Decimal(18, 8)
  mines          Int
  boardSize      Int         @default(5)
  minePositions  Int[]       // server-authoritative mine indices, never sent to client
  status         GameStatus  @default(ACTIVE)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  multiplier     Decimal     @default(1) @db.Decimal(18, 8)
  payout         Decimal?    @db.Decimal(18, 8)
  createdAt      DateTime    @default(now())
  reveals        Reveal[]

  @@index([userId, createdAt])
  @@index([status])
}

model Reveal {
  id        String    @id @default(cuid())
  roundId   String
  round     GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  tileIndex Int
  isMine    Boolean
  createdAt DateTime  @default(now())

  @@unique([roundId, tileIndex])
  @@index([roundId, createdAt])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TxType
  amount    Decimal  @db.Decimal(18, 8)
  roundId   String?
  idempotencyKey String? @unique
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SlotRound {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet            Decimal   @db.Decimal(18, 8)
  payout         Decimal   @default(0) @db.Decimal(18, 8)
  multiplier     Decimal   @default(0) @db.Decimal(18, 8)
  grid           Json      // 5x3 number array representing symbol IDs
  winningLines   Json      // Array of { lineIndex, symbol, matchCount, payout }
  isFreeSpin     Boolean   @default(false)
  freeSpinsWon   Int       @default(0)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

model RouletteRound {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalBet       Decimal   @db.Decimal(18, 8)
  winningNumber  Int       // 0 to 36
  bets           Json      // Array of { type, numbers: number[], amount: number }
  payout         Decimal   @default(0) @db.Decimal(18, 8)
  multiplier     Decimal   @default(0) @db.Decimal(18, 8)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

model BlackjackRound {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet            Decimal    @db.Decimal(18, 8)
  playerHands    Json       // Array of { cards: string[], bet: number, status: string, score: number }
  dealerHand     Json       // { cards: string[], score: number, hidden: boolean }
  currentHandIdx Int        @default(0)
  status         GameStatus @default(ACTIVE)
  payout         Decimal    @default(0) @db.Decimal(18, 8)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model CoinFlipRound {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bet            Decimal    @db.Decimal(18, 8)
  flips          Json       // Array of { guess: 'HEADS'|'TAILS', outcome: 'HEADS'|'TAILS', multiplier: number }
  streak         Int        @default(0)
  multiplier     Decimal    @default(1) @db.Decimal(18, 8)
  status         GameStatus @default(ACTIVE)
  payout         Decimal?   @db.Decimal(18, 8)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

enum Role {
  USER
  ADMIN
}

enum GameStatus {
  ACTIVE
  WON
  LOST
  PUSH
  CANCELLED
}

enum TxType {
  BET
  WIN
  DEPOSIT
  WITHDRAW
  ADMIN_ADJUST
  REFUND
}