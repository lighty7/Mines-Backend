# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=10000

# From Render PostgreSQL (or local Postgres for dev)
# Example: postgresql://user:password@localhost:5432/mines
DATABASE_URL=postgresql://user:password@localhost:5432/mines

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# bcrypt cost factor (10-12 recommended; keep small on Render free tier)
BCRYPT_ROUNDS=10

# SMTP Email Configuration (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mines Game <noreply@minesgame.com>"